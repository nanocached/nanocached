root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,mts,cts,js,mjs,cjs,json,yaml,yml,sh,toml}]
indent_size = 2

[*.{go,mod}]
indent_style = tab

[Makefile]
indent_style = tab

# A trailing double space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{pem,crt,key}]
insert_final_newline = unset
