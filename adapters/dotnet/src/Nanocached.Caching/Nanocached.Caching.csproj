<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>Nanocached.Caching</PackageId>
    <Version>0.1.0</Version>
    <Authors>Takashi Yamashina</Authors>
    <Description>IDistributedCache adapter for nanocached, on top of the Nanocached .NET SDK.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nanocached.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nanocached/nanocached</RepositoryUrl>
    <PackageTags>nanocached;cache;distributed-cache;idistributedcache;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc comments live on the types and the members that need them;
         requiring one on every trivial constructor is noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Separate module from its SDK core (issue #108's shared spec) —
         outside the six-language SDK parity policy (issue #25) — but
         still built from the sibling checkout, not a published package,
         so a fresh clone needs no locally-installed SDK artifact. -->
    <ProjectReference Include="../../../../sdk/dotnet/src/Nanocached/Nanocached.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
