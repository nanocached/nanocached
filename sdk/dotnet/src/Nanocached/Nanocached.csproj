<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>Nanocached</PackageId>
    <Version>0.1.0</Version>
    <Authors>Takashi Yamashina</Authors>
    <Description>Async client SDK for nanocached, a tiny distributed cache with client-side replication.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nanocached.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/t0k0sh1/nanocached</RepositoryUrl>
    <PackageTags>nanocached;cache;distributed-cache;client;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc comments live on the types and the members that need them;
         requiring one on every trivial constructor is noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Nanocached.Tests" />
  </ItemGroup>

</Project>
