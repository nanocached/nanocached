<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Nanocached</PackageId>
    <Version>0.6.2</Version>
    <Authors>Takashi Yamashina</Authors>
    <Description>Async client SDK for nanocached, a tiny distributed cache with client-side replication.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nanocached.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nanocached/nanocached</RepositoryUrl>
    <PackageTags>nanocached;cache;distributed-cache;client;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Nanocached.Tests" />
  </ItemGroup>

</Project>
