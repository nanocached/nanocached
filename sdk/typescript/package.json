{
  "name": "nanocached",
  "version": "0.4.0",
  "description": "TypeScript SDK for nanocached, a tiny distributed cache with client-side replication",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanocached/nanocached.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/nanocached/nanocached/tree/main/sdk/typescript#readme",
  "bugs": {
    "url": "https://github.com/nanocached/nanocached/issues"
  },
  "keywords": [
    "nanocached",
    "cache",
    "distributed-cache",
    "rendezvous-hashing",
    "client",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
